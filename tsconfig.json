{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "isolatedModules": true,
    "rootDir": ".",
    "types": ["node", "vitest/globals"],
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@app/redis": ["./libs/redis/src/index.ts"],
      "@app/redis/*": ["./libs/redis/src/*"],
      "@app/rsa": ["./libs/rsa/src/index.ts"],
      "@app/rsa/*": ["./libs/rsa/src/*"],
      "@app/decorators": ["./libs/decorators/src/index.ts"],
      "@app/decorators/*": ["./libs/decorators/src/*"]
    }
  }
}
